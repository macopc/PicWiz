# PicWiz needs no env file, API keys, database, auth or object storage.
# Image processing, annotations, preset import and ZIP creation are browser-local.
# Never add secrets to NEXT_PUBLIC_* variables.

# Optional Next.js port; pass to the process (default 3000):
# PORT=3000 npm start

# Optional externally managed dev/production server for Playwright.
# Export this in the test shell; Playwright does not load this file itself.
# PLAYWRIGHT_BASE_URL=http://localhost:3000 npm test

# Optional Chromium-only executable override. Normally install all engines:
# npx playwright install --with-deps chromium firefox webkit
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/absolute/path/to/chromium
