{
  "name": "picwiz",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "seed": "node scripts/seed.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fflate": "0.8.3",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "description": "A local-first screenshot studio with presets, annotations, social sizes and batch PNG exports.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macopc/PicWiz.git"
  },
  "bugs": {
    "url": "https://github.com/macopc/PicWiz/issues"
  },
  "homepage": "https://github.com/macopc/PicWiz#readme",
  "engines": {
    "node": ">=24 <25"
  }
}
